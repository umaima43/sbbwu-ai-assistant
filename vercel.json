{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "chatbot-frontend": {
      "root": "chatbot-frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(auth/.*|query.*|chat.*|feedback.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "chatbot-frontend"
      }
    }
  ]
}